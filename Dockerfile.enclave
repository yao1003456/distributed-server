FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install kmstool-enclave-cli
# NOTE: In a real deployment, verified binaries should be used.
# This is a placeholder for where the binary installation would happen.
# We will assume it is available or copied in.
COPY kmstool-enclave-cli /usr/local/bin/kmstool-enclave-cli
RUN chmod +x /usr/local/bin/kmstool-enclave-cli

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY proxy_enclave.py .
COPY umbral-pre/ umbral-pre/

# The enclave runs the python script directly or via a wrapper
CMD ["python3", "/app/proxy_enclave.py"]
