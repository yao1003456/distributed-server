# Stage 1: Build the kmstool-enclave-cli
FROM amazonlinux:2023 as builder

RUN dnf update -y && \
    dnf install -y gcc gcc-c++ make cmake git zip jq tar \
    openssl-devel zlib-devel wget aws-cli

# Clone and compile aws-nitro-enclaves-sdk-c
RUN git clone https://github.com/aws/aws-nitro-enclaves-sdk-c.git /sdk
WORKDIR /sdk
RUN ./build.sh --enable-kmstool

# Stage 2: Runtime Environment
FROM python:3.11-slim

# Install necessary system dependencies for cryptography and networking
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    jq \
    libc-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the compiled kmstool from the builder stage
COPY --from=builder /sdk/bin/kmstool-enclave-cli /usr/local/bin/
RUN chmod +x /usr/local/bin/kmstool-enclave-cli

# Set up working directory
WORKDIR /app

# Copy requirements and install them
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy proxy application code
COPY proxy_enclave.py .

# Optional: Document the port used for local VSOCK communication
EXPOSE 12345

# Command to run the proxy server
CMD ["python", "proxy_enclave.py"]
